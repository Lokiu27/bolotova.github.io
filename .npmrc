# onnxruntime-node (транзитивная зависимость @huggingface/transformers)
# на Linux/x64 при install качает CUDA-бинарники с
# github.com/microsoft/onnxruntime/releases — репозиторий удалён, и npm ci
# падал с 404. CUDA EP сборке не нужен: transformers работает в браузерном
# web worker (WebGPU), CPU-бинарники лежат в самом npm-пакете.
# npm прокидывает этот ключ в скрипты как npm_config_onnxruntime_node_install_cuda,
# который install.js читает как "skip" (npmrc-эквивалент флага
# --onnxruntime-node-install-cuda=skip).
onnxruntime-node-install-cuda=skip
